@using DATERP.Examination.Web.Pages.Examination.ExamSubjects
@using DATERP.Examination.Localization
@model IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExaminationResource> L

@section PageStyles {
    <style>
        .subject-card {
            transition: all 0.3s ease;
            background: linear-gradient(145deg, #1a2742 0%, #2d1f4e 50%, #1a2742 100%);
            border: 1px solid rgba(99, 102, 241, 0.3) !important;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .subject-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, transparent 50%);
            pointer-events: none;
        }

        .subject-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(99, 102, 241, 0.25) !important;
            border-color: rgba(99, 102, 241, 0.5) !important;
        }

        .subject-card .card-title,
        .subject-card h4 {
            color: #ffffff !important;
        }

        .subject-card .text-muted,
        .subject-card h6.text-muted {
            color: rgba(255, 255, 255, 0.7) !important;
        }

        .subject-card .text-heading {
            color: #ffffff !important;
        }

        .subject-card .stats-section {
            background: rgba(255, 255, 255, 0.08) !important;
            border-color: rgba(255, 255, 255, 0.15) !important;
        }

        .subject-card .stats-section .border-end {
            border-color: rgba(255, 255, 255, 0.15) !important;
        }

        .subject-card .stats-section i {
            color: #6366f1 !important;
        }

        .subject-card .stats-section small {
            color: rgba(255, 255, 255, 0.6) !important;
        }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}

@functions {
    public string GetCardGradient(string code, string colorClass)
    {
        var normalizedCode = code?.ToUpper() ?? "";

        if (normalizedCode.Contains("EXCEL"))
            return "linear-gradient(135deg, #064e3b 0%, #065f46 50%, #064e3b 100%)"; /* Green (Excel) */

        if (normalizedCode.Contains("POWERPOINT") || normalizedCode.Contains("PPT"))
            return "linear-gradient(135deg, #7c2d12 0%, #9a3412 50%, #7c2d12 100%)"; /* Orange (PowerPoint) */

        if (normalizedCode.Contains("WORD"))
            return "linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #1e3a8a 100%)"; /* Blue (Word) */

        if (normalizedCode.Contains("ACCESS"))
            return "linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #7f1d1d 100%)"; /* Red (Access) */

        if (normalizedCode.Contains("OUTLOOK"))
            return "linear-gradient(135deg, #0c4a6e 0%, #0ea5e9 50%, #0c4a6e 100%)"; /* Cyan (Outlook) */

        // Fallback to ColorClass if Code doesn't match
        return colorClass?.ToLower() switch
        {
            "success" => "linear-gradient(135deg, #064e3b 0%, #065f46 50%, #064e3b 100%)",
            "warning" => "linear-gradient(135deg, #7c2d12 0%, #9a3412 50%, #7c2d12 100%)",
            "danger" => "linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #7f1d1d 100%)",
            "info" => "linear-gradient(135deg, #0c4a6e 0%, #0ea5e9 50%, #0c4a6e 100%)",
            "secondary" => "linear-gradient(135deg, #1f2937 0%, #374151 50%, #1f2937 100%)",
            _ => "linear-gradient(135deg, #1e3a8a 0%, #312e81 50%, #1e3a8a 100%)"
        };
    }

    public string GetBorderColor(string code, string colorClass)
    {
        var normalizedCode = code?.ToUpper() ?? "";

        if (normalizedCode.Contains("EXCEL")) return "rgba(16, 185, 129, 0.4)";
        if (normalizedCode.Contains("POWERPOINT") || normalizedCode.Contains("PPT")) return "rgba(249, 115, 22, 0.4)";
        if (normalizedCode.Contains("WORD")) return "rgba(59, 130, 246, 0.4)";
        if (normalizedCode.Contains("ACCESS")) return "rgba(239, 68, 68, 0.4)";
        if (normalizedCode.Contains("OUTLOOK")) return "rgba(6, 182, 212, 0.4)";

        return "rgba(99, 102, 241, 0.3)";
    }

    public string GetSubjectMainColor(string code, string colorClass)
    {
        var normalizedCode = code?.ToUpper() ?? "";

        if (normalizedCode.Contains("EXCEL")) return "#064e3b"; /* Green */
        if (normalizedCode.Contains("POWERPOINT") || normalizedCode.Contains("PPT")) return "#9a3412"; /* Orange/Red */
        if (normalizedCode.Contains("WORD")) return "#1e3a8a"; /* Blue */
        if (normalizedCode.Contains("ACCESS")) return "#991b1b"; /* Red */
        if (normalizedCode.Contains("OUTLOOK")) return "#0c4a6e"; /* Cyan */

        return "#312e81"; /* Indigo */
    }
}


<!-- Hero Section -->
<div class="card mb-5 border-0 overflow-hidden position-relative"
    style="background: linear-gradient(135deg, var(--bs-primary) 0%, #a29bfe 100%); color: white;">
    <div class="card-body p-4 p-md-5">
        <div class="row align-items-center">
            <div class="col-md-8 z-1">
                <div
                    class="d-inline-block rounded-pill bg-black bg-opacity-25 px-3 py-1 mb-3 text-white border border-white border-opacity-25">
                    <small class="fw-bold text-uppercase">@L["Section.Hero.Badge"]</small>
                </div>
                <h2 class="text-white fw-bold mb-3"><i class="ti ti-award me-2"></i>@L["Section.Hero.Title"]</h2>
                <p class="mb-4 text-white opacity-90 fs-5" style="max-width: 800px;">
                    @Html.Raw(L["Section.Hero.Subtitle"])
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <div class="d-flex align-items-center bg-white rounded-pill px-2 py-1 text-primary">
                        <i class="ti ti-certificate me-1"></i>
                        <span class="fw-bold small">@L["Feature.Standard"]</span>
                    </div>
                    <div class="d-flex align-items-center bg-white rounded-pill px-2 py-1 text-primary">
                        <i class="ti ti-infinite me-1"></i>
                        <span class="fw-bold small">@L["Feature.LifetimeAccess"]</span>
                    </div>
                    <div class="d-flex align-items-center bg-white rounded-pill px-2 py-1 text-primary">
                        <i class="ti ti-device-laptop me-1"></i>
                        <span class="fw-bold small">@L["Feature.RealExamSimulation"]</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-none d-md-block position-relative z-1 text-center">
                <div class="position-relative d-inline-block">
                    <i class="ti ti-trophy text-white opacity-25" style="font-size: 12rem;"></i>
                    <i class="ti ti-star-filled text-warning position-absolute top-0 end-0 translate-middle-y"
                        style="font-size: 3rem; filter: drop-shadow(0 0 10px rgba(0,0,0,0.2));"></i>
                </div>
            </div>
        </div>
        <!-- Decorative Circles -->
        <div class="position-absolute top-0 end-0 translate-middle-y me-n5 mt-n5 bg-white opacity-10 rounded-circle"
            style="width: 300px; height: 300px;"></div>
    </div>
</div>

<!-- Exam Subjects Grid -->
<div class="row g-4 mb-5">
    @if (Model.ExamSubjects != null && Model.ExamSubjects.Any())
    {
        foreach (var item in Model.ExamSubjects)
        {
            <div class="col-xl-4 col-md-6">
                <div class="card h-100 subject-card"
                    style="background: @GetCardGradient(item.Code, item.ColorClass); border: 1px solid @GetBorderColor(item.Code, item.ColorClass) !important;">
                    <div class="card-body p-4">
                        <!-- Header: Icon & Badge -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="avatar avatar-xl rounded p-1" style="background-color: #eeedf0;">
                                <span class="avatar-initial rounded" style="background: transparent;">
                                    <i class="ti @item.Icon text-black" style="font-size: 2rem;"></i>
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.BadgeText))
                            {
                                <span class="badge bg-label-@item.ColorClass rounded-pill">
                                    <i class="ti @item.BadgeIcon me-1"></i> @L[item.BadgeText]
                                </span>
                            }
                        </div>

                        <!-- Content -->
                        <h4 class="card-title mb-1 text-truncate text-white" title="@item.Name">@item.Name</h4>
                        <h6 class="fw-normal mb-3" style="color: rgba(255,255,255,0.7);">@item.Title</h6>

                        <p class="small mb-4 line-clamp-2" style="min-height: 40px; color: rgba(255,255,255,0.6);">
                            @item.Description
                        </p>

                        <!-- Stats -->
                        <div class="d-flex justify-content-between align-items-center rounded p-3 mb-4"
                            style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
                            <div class="text-center w-100" style="border-right: 1px solid rgba(255,255,255,0.1);">
                                <i class="ti ti-book-2 mb-1 text-white"></i>
                                <h6 class="mb-0 fw-bold text-white">@item.TotalExamLists</h6>
                                <small
                                    style="font-size: 0.75rem; color: rgba(255,255,255,0.7);">@L["Stat.TotalExamLists"]</small>
                            </div>
                            <div class="text-center w-100" style="border-right: 1px solid rgba(255,255,255,0.1);">
                                <i class="ti ti-folder mb-1 text-white"></i>
                                <h6 class="mb-0 fw-bold text-white">@item.TotalExamProjects</h6>
                                <small
                                    style="font-size: 0.75rem; color: rgba(255,255,255,0.7);">@L["Stat.TotalExamProjects"]</small>
                            </div>
                            <div class="text-center w-100">
                                <i class="ti ti-list-check mb-1 text-white"></i>
                                <h6 class="mb-0 fw-bold text-white">@item.TotalExamTasks</h6>
                                <small
                                    style="font-size: 0.75rem; color: rgba(255,255,255,0.7);">@L["Stat.TotalExamTasks"]</small>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <a href="/Examination/ExamLists?subjectCode=@item.Code" class="btn w-100 fw-bold border-0 shadow-sm"
                            style="background-color: #ffffff; color: @GetSubjectMainColor(item.Code, item.ColorClass); transition: all 0.2s ease;">
                            <i class="ti ti-login me-1"></i> @L["Action.AccessExam"]
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="mb-3">
                        <span class="avatar avatar-xl rounded-circle bg-label-warning">
                            <i class="ti ti-alert-circle fs-2"></i>
                        </span>
                    </div>
                    <h4>@L["Message.NoData"]</h4>
                    <p class="text-muted">@L["Message.SystemUpdating"]</p>
                </div>
            </div>
        </div>
    }
</div>