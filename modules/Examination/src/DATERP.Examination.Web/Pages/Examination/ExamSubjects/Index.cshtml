@page
@using DATERP.Examination.Web.Pages.Examination.ExamSubjects
@using DATERP.Examination.Localization
@using Education.Models
@model IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExaminationResource> L

@section scripts {
    @if (!Model.IsStudent)
    {
        <abp-script src="/Pages/Examination/ExamSubjects/Index.js" />
    }
}

@if (Model.IsStudent)
{
    @await Html.PartialAsync("_StudentView", Model)
}
else
{
    @await Html.PartialAsync("_AdminView", Model)
}