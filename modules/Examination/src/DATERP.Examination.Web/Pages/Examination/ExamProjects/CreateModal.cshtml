@page
@using DATERP.Examination.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using DATERP.Examination.Web.Pages.Examination.ExamProjects
@model DATERP.Examination.Web.Pages.Examination.ExamProjects.CreateModalModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExaminationResource> L
@{
    Layout = null;
}
<abp-dynamic-form abp-model="ExamProject" asp-page="/Examination/ExamProjects/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["NewExamProject"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
