@*
    _AdminTable.cshtml - Reusable Admin Table Component
    Usage:
    @await Html.PartialAsync("~/Pages/Shared/_AdminTable.cshtml", new Education.Models.AdminTableViewModel {
        Title = "Môn thi",
        TableId = "ExamSubjectsTable",
        CreateButtonId = "NewExamSubjectButton",
        CreateButtonText = "Thêm mới",
        CreateButtonIcon = "ti ti-plus"
    })
*@
@model Education.Models.AdminTableViewModel

<div id="@(Model.TableId)PageContainer" class="admin-table-container">
    @* Stats Cards Row (Optional) *@
    @if (Model.Stats != null && Model.Stats.Any())
    {
        @await Html.PartialAsync("~/Pages/Shared/_StatCards.cshtml", Model.Stats)
    }

    @* Main Table Card *@
    <div class="card admin-table-card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(Model.Icon))
                {
                    <i class="@Model.Icon me-2 fs-4 text-primary"></i>
                }
                <h5 class="card-title m-0">@Model.Title</h5>
            </div>
            <div class="d-flex align-items-center">
                @* Search Input *@
                @if (Model.ShowSearchBar)
                {
                    <div id="@(Model.TableId)SearchWrapper" class="me-3">
                        <div class="dt-search">
                            <i class="ti ti-search search-icon"></i>
                            <input type="search" class="form-control" placeholder="@Model.SearchPlaceholder"
                                id="@(Model.TableId)SearchInput">
                        </div>
                    </div>
                }
                @* Export Button *@
                @if (Model.ShowExportButton)
                {
                    <button type="button" class="btn btn-outline-secondary me-2" id="@(Model.TableId)ExportBtn">
                        <i class="ti ti-download me-1"></i> Xuất Excel
                    </button>
                }
                @* Create Button *@
                @if (Model.ShowCreateButton)
                {
                    <button type="button" class="btn btn-primary" id="@Model.CreateButtonId">
                        <i class="@Model.CreateButtonIcon me-1"></i> @Model.CreateButtonText
                    </button>
                }
            </div>
        </div>
        <div class="card-body p-0">
            @* Filter Bar (Optional) *@
            @if (Model.FilterOptions != null && Model.FilterOptions.Any())
            {
                <div class="admin-table-toolbar px-3 py-2 border-bottom bg-light">
                    <div class="d-flex justify-content-end gap-2">
                        @foreach (var filter in Model.FilterOptions)
                        {
                            <select class="form-select form-select-sm admin-table-filter" data-filter="@filter.Key"
                                style="width: auto;">
                                <option value="">@filter.Label</option>
                                @foreach (var option in filter.Options)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        }
                    </div>
                </div>
            }

            @* DataTable *@
            <div class="table-responsive">
                <table id="@Model.TableId" class="table table-hover admin-table mb-0">
                    <thead class="table-light">
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        @* Footer with pagination info *@
        @* Footer with pagination info *@
        <div id="@(Model.TableId)Footer"
            class="card-footer bg-white border-top py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        </div>
    </div>
</div>