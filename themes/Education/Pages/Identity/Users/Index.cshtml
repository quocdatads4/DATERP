@page
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Identity
@using Volo.Abp.Identity.Web.Pages.Identity.Users
@using Volo.Abp.Identity.Web.Navigation
@using Volo.Abp.Identity.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inherits Volo.Abp.AspNetCore.Mvc.UI.RazorPages.AbpPage
@model Education.Pages.Identity.Users.IndexModel
@inject IHtmlLocalizer<IdentityResource> L
@inject IAuthorizationService AuthorizationService
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Quản lý người dùng";
    PageLayout.Content.MenuItemName = IdentityMenuNames.Users;
}

@section styles {
    <link rel="stylesheet" href="/themes/education/css/stat-cards.css" />
    <link rel="stylesheet" href="/themes/education/css/identity/users/index.css" />
}

@section scripts {
    <script src="/client-proxies/identity-proxy.js"></script>
    <script src="/themes/education/js/identity/users/index.js"></script>
}

@* Thẻ thống kê *@
@* Thẻ thống kê *@
@{
    var stats = new List<Education.Models.StatCardModel>
{
new Education.Models.StatCardModel {
Title = "Tổng số người dùng",
Value = Model.TotalUsers.ToString(),
Icon = "ti ti-users",
ColorClass = "primary"
},
new Education.Models.StatCardModel {
Title = "Đang hoạt động",
Value = Model.ActiveUsers.ToString(),
Icon = "ti ti-user-check",
ColorClass = "success"
},
new Education.Models.StatCardModel {
Title = "Ngừng hoạt động",
Value = Model.InactiveUsers.ToString(),
Icon = "ti ti-user-x",
ColorClass = "danger"
},
new Education.Models.StatCardModel {
Title = "Chờ xác nhận",
Value = "0",
Icon = "ti ti-clock",
ColorClass = "warning"
}
};
}
@await Html.PartialAsync("~/Pages/Shared/_StatCards.cshtml", stats)

@* Bảng danh sách người dùng *@
<div class="card" id="IdentityUsersWrapper">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách người dùng</h5>
        <div class="d-flex align-items-center">
            <div id="SearchWrapper" class="me-3"></div>
            @if (await AuthorizationService.IsGrantedAsync(IdentityPermissions.Users.Create))
            {
                <button type="button" class="btn btn-primary" id="CreateUserButton" name="CreateUser">
                    <i class="ti ti-plus me-1"></i> Thêm mới
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table" id="UsersTable"></table>
    </div>
</div>