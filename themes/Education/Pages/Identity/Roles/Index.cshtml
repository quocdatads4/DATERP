@page
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Identity
@using Volo.Abp.Identity.Web.Pages.Identity.Roles
@using Volo.Abp.Identity.Web.Navigation
@using Volo.Abp.Identity.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inherits Volo.Abp.AspNetCore.Mvc.UI.RazorPages.AbpPage
@model Volo.Abp.Identity.Web.Pages.Identity.Roles.IndexModel
@inject IHtmlLocalizer<IdentityResource> L
@inject IAuthorizationService AuthorizationService
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L["Roles"].Value;
    PageLayout.Content.MenuItemName = IdentityMenuNames.Roles;
}

@section styles {
    <link rel="stylesheet" href="/themes/education/css/identity/users/index.css" />
}

@section scripts {
    <script src="/client-proxies/identity-proxy.js"></script>
    <script src="/themes/education/js/identity/roles/index.js"></script>
}

@* Thống kê vai trò *@
<div class="row mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat-primary">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span class="text-white opacity-75">Tổng số vai trò</span>
                        <div class="d-flex align-items-center my-1">
                            <h4 class="mb-0 me-2 text-white" id="totalRolesCount">—</h4>
                        </div>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded">
                            <i class="ti ti-shield"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat-success">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span class="text-white opacity-75">Vai trò công khai</span>
                        <div class="d-flex align-items-center my-1">
                            <h4 class="mb-0 me-2 text-white" id="publicRolesCount">—</h4>
                        </div>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded">
                            <i class="ti ti-world"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat-warning">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span class="text-white opacity-75">Vai trò mặc định</span>
                        <div class="d-flex align-items-center my-1">
                            <h4 class="mb-0 me-2 text-white" id="defaultRolesCount">—</h4>
                        </div>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded">
                            <i class="ti ti-star"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat-danger">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span class="text-white opacity-75">Vai trò hệ thống</span>
                        <div class="d-flex align-items-center my-1">
                            <h4 class="mb-0 me-2 text-white" id="staticRolesCount">—</h4>
                        </div>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded">
                            <i class="ti ti-lock"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Bảng danh sách vai trò *@
<div class="card" id="IdentityRolesWrapper">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="ti ti-shield-check me-2"></i>@L["Roles"]</h5>
        <div class="d-flex align-items-center">
            @* Search input *@
            <div class="input-group input-group-merge me-3" style="width: 250px;">
                <span class="input-group-text"><i class="ti ti-search"></i></span>
                <input type="text" class="form-control" id="RolesSearchInput" placeholder="Tìm kiếm vai trò..." />
            </div>

            @if (await AuthorizationService.IsGrantedAsync(IdentityPermissions.Roles.Create))
            {
                <button type="button" class="btn btn-primary" name="CreateRole">
                    <i class="ti ti-plus me-1"></i> @L["NewRole"]
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table" id="RolesTable"></table>
    </div>
</div>